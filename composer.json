{
    "name": "justinholtweb/craft-puppy",
    "description": "A lightweight Craft CMS 5 control panel companion that follows editors through their session, tracking visited pages, edits, and providing quick links back.",
    "version": "5.0.5",
    "type": "craft-plugin",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\puppy\\": "src/"
        }
    },
    "extra": {
        "handle": "puppy",
        "name": "Puppy",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "description": "A control panel companion that tracks your session trail.",
        "class": "justinholtweb\\puppy\\Plugin",
        "hasCpSection": false
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.0",
        "codeception/module-datafactory": "^3.0",
        "codeception/module-phpbrowser": "^3.0",
        "codeception/module-rest": "^3.0",
        "codeception/module-yii2": "^1.1",
        "vlucas/phpdotenv": "^5.4",
        "fakerphp/faker": "^1.19",
        "league/factory-muffin": "^3.3"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "codecept run unit"
    }
}
